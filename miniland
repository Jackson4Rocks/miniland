#!/bin/sh
set -eu

STATE_DIR="$HOME/.local/state/miniland"
STATE_FILE="$STATE_DIR/state.json"
SPECIAL_WORKSPACE="special:miniland"

die() {
    printf '%s\n' "miniland: $*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

need hyprctl
need jq

mkdir -p "$STATE_DIR"
[ -f "$STATE_FILE" ] || printf '%s\n' '[]' > "$STATE_FILE"

active_json() {
    hyprctl activewindow -j
}

clients_json() {
    hyprctl clients -j
}

is_address_alive() {
    address="$1"
    clients_json | jq -e --arg address "$address" 'any(.[]; .address == $address)' >/dev/null 2>&1
}

remove_address() {
    address="$1"
    tmp="$STATE_FILE.tmp"
    jq --arg address "$address" 'map(select(.address != $address))' "$STATE_FILE" > "$tmp"
    mv "$tmp" "$STATE_FILE"
}

prune_state() {
    clients="$(clients_json)"
    tmp="$STATE_FILE.tmp"
    jq --argjson clients "$clients" '
        map(. as $item | select(any($clients[]; .address == $item.address)))
    ' "$STATE_FILE" > "$tmp"
    mv "$tmp" "$STATE_FILE"
}

save_window() {
    address="$1"
    workspace_id="$2"
    workspace_name="$3"
    monitor="$4"
    title="$5"
    app_class="$6"

    tmp="$STATE_FILE.tmp"

    jq \
        --arg address "$address" \
        --arg workspace_id "$workspace_id" \
        --arg workspace_name "$workspace_name" \
        --arg monitor "$monitor" \
        --arg title "$title" \
        --arg class "$app_class" '
        if any(.[]; .address == $address) then .
        else . + [{
            address: $address,
            workspace_id: $workspace_id,
            workspace_name: $workspace_name,
            monitor: $monitor,
            title: $title,
            class: $class,
            minimized_at: (now | floor)
        }]
        end
    ' "$STATE_FILE" > "$tmp"

    mv "$tmp" "$STATE_FILE"
}

restore_address() {
    address="$1"

    entry="$(jq -c --arg address "$address" 'map(select(.address == $address)) | .[0]' "$STATE_FILE")"
    [ "$entry" != "null" ] || die "window is not tracked as minimized"

    if ! is_address_alive "$address"; then
        remove_address "$address"
        die "that window no longer exists"
    fi

    workspace_id="$(printf '%s' "$entry" | jq -r '.workspace_id')"
    [ -n "$workspace_id" ] || die "saved workspace is invalid"

    hyprctl dispatch movetoworkspacesilent "id:$workspace_id,address:$address" >/dev/null
    hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1 || true
    remove_address "$address"
}

minimize() {
    window="$(active_json)"
    address="$(printf '%s' "$window" | jq -r '.address // empty')"
    [ -n "$address" ] || die "no focused window"

    workspace_name="$(printf '%s' "$window" | jq -r '.workspace.name // empty')"

    if [ "$workspace_name" = "$SPECIAL_WORKSPACE" ]; then
        restore_address "$address"
        return
    fi

    workspace_id="$(printf '%s' "$window" | jq -r '.workspace.id // empty')"
    monitor="$(printf '%s' "$window" | jq -r '.monitor // empty')"
    title="$(printf '%s' "$window" | jq -r '.title // empty')"
    app_class="$(printf '%s' "$window" | jq -r '.class // .initialClass // empty')"

    [ -n "$workspace_id" ] || die "could not determine the current workspace"

    save_window "$address" "$workspace_id" "$workspace_name" "$monitor" "$title" "$app_class"
    hyprctl dispatch movetoworkspacesilent "$SPECIAL_WORKSPACE,address:$address" >/dev/null
}

restore_last() {
    prune_state
    address="$(jq -r '.[-1].address // empty' "$STATE_FILE")"
    [ -n "$address" ] || die "no minimized windows"
    restore_address "$address"
}

restore_index() {
    index="$1"
    prune_state

    case "$index" in
        ''|*[!0-9]*) die "restore expects a number, e.g. miniland restore 1" ;;
    esac

    count="$(jq 'length' "$STATE_FILE")"
    [ "$index" -ge 1 ] 2>/dev/null || die "index must start at 1"
    [ "$index" -le "$count" ] 2>/dev/null || die "no minimized window at index $index"

    address="$(jq -r --argjson index "$index" '.[($index - 1)].address' "$STATE_FILE")"
    restore_address "$address"
}

restore_all() {
    prune_state
    addresses="$(jq -r '.[].address' "$STATE_FILE")"
    [ -n "$addresses" ] || die "no minimized windows"

    printf '%s\n' "$addresses" |
    while IFS= read -r address; do
        [ -n "$address" ] || continue
        restore_address "$address" || true
    done
}

toggle_shelf() {
    hyprctl dispatch togglespecialworkspace miniland >/dev/null
}

list_windows() {
    prune_state
    count="$(jq 'length' "$STATE_FILE")"

    if [ "$count" -eq 0 ]; then
        printf '%s\n' "No minimized windows."
        return 0
    fi

    jq -r '
        to_entries[] |
        "\(.key + 1)\t\(.value.class // "unknown")\t\(.value.title // "")\tworkspace \(.value.workspace_name // .value.workspace_id)"
    ' "$STATE_FILE" |
    while IFS="$(printf '\t')" read -r number class title workspace; do
        printf '%s  %-24s  %s  (%s)\n' "$number." "$class" "$title" "$workspace"
    done
}

usage() {
    cat <<'EOF'
Miniland - lightweight window minimizing for Hyprland

Usage:
  miniland minimize       Minimize the focused window
  miniland restore-last   Restore the most recently minimized window
  miniland restore N      Restore minimized window N from 'miniland list'
  miniland restore-all    Restore every minimized window
  miniland list           Show minimized windows
  miniland toggle-shelf   Show/hide the Miniland special workspace
  miniland toggle         Minimize focused window / restore it if focused in Miniland
  miniland help           Show this help
EOF
}

command_name="help"
[ "$#" -ge 1 ] && command_name="$1"

case "$command_name" in
    minimize) minimize ;;
    restore-last) restore_last ;;
    restore)
        [ "$#" -ge 2 ] || die "usage: miniland restore N"
        restore_index "$2"
        ;;
    restore-all) restore_all ;;
    list) list_windows ;;
    toggle-shelf) toggle_shelf ;;
    toggle) minimize ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
